# The same two libraries, and a command for each that links it: /usr/bin/brotli the Brotli library, and
# /usr/bin/xmllint and /usr/bin/xmlcatalog the XML library.
FROM alpine:3.12@sha256:c75ac27b49326926b803b9ed43bf088bc220d22556de1bc5f72d742c91398f69
RUN apk add --no-cache brotli-libs libxml2 brotli libxml2-utils
