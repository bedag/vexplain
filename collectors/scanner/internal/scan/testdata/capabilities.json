{
  "roles": [
    "Spoke"
  ],
  "produces": [
    {
      "type": "ch.bedag.vexplain.sbom.v1alpha1",
      "scope": "Hub",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:vexplain:schema:ch.bedag.vexplain.sbom.v1alpha1",
        "title": "SBOM",
        "description": "A subject's package inventory, such as what a scanner found in the filesystem of a platform manifest: its distribution, each package with its ID, name, version, type, purl and CPEs, and the producer's SBOM document when it has one. The event's coverage is the producer's: the scanner's is the share of the ELF files that packages own.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "packages",
          "producer"
        ],
        "properties": {
          "distro": {
            "$ref": "#/$defs/distro"
          },
          "packages": {
            "description": "The packages, each with an ID of its own. Empty when the subject has none.",
            "type": "array",
            "items": {
              "$ref": "#/$defs/package"
            }
          },
          "producer": {
            "$ref": "#/$defs/producer"
          },
          "failedCatalogers": {
            "description": "The producer's catalogers that failed, whose packages the inventory may lack.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "document": {
            "$ref": "#/$defs/document"
          }
        },
        "$defs": {
          "distro": {
            "description": "The distribution of the subject, as its os-release file names it. Absent when the producer found none.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "description": "os-release's ID, such as debian or alpine.",
                "type": "string",
                "minLength": 1
              },
              "version": {
                "description": "os-release's VERSION_ID, such as 12 or 3.22.2. Absent for a rolling distribution.",
                "type": "string",
                "minLength": 1
              },
              "codename": {
                "description": "os-release's VERSION_CODENAME, such as bookworm.",
                "type": "string",
                "minLength": 1
              },
              "idLike": {
                "description": "os-release's ID_LIKE: the distributions that this one derives from.",
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "package": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "type"
            ],
            "properties": {
              "id": {
                "description": "The package's ID, unique within the SBOM. A match names its package by it.",
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "description": "Absent for a package that has none.",
                "type": "string",
                "minLength": 1
              },
              "type": {
                "description": "The producer's type of the package, such as deb, rpm, apk, go-module or java-archive.",
                "type": "string"
              },
              "purl": {
                "description": "The package URL, with the producer's qualifiers. An OS package's purl names its source package in the qualifier upstream and its distribution in distro, as Syft writes them: a distribution tracks many vulnerabilities by the source package.",
                "type": "string",
                "minLength": 1
              },
              "cpes": {
                "description": "The package's CPEs, in the producer's order.",
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "modularityLabel": {
                "description": "An RPM's modularity label, name:stream:version:context, such as nodejs:20:8090020240101000000:a1b2c3d4: the module stream that the RPM comes from. The empty string for an RPM of no module stream, and absent when the producer doesn't know. An RPM-based distribution publishes advisories per module stream, and a matcher that doesn't know a package's stream applies those of every stream to it: then an advisory that another stream is fixed, as AlmaLinux publishes them, hides the vulnerability of the package's own.",
                "type": "string"
              }
            }
          },
          "document": {
            "description": "The producer's SBOM document, which a vulnerability matcher reads as it is, so that it matches all that the document holds. The packages stay, each with the ID that the document gives it, by which rules join a finding to its package. Absent when the producer has none: a matcher then reads the packages.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "format",
              "content"
            ],
            "properties": {
              "format": {
                "description": "The document's format, in Syft's names. Grype reads all three.",
                "enum": [
                  "syft-json",
                  "cyclonedx-json",
                  "spdx-json"
                ]
              },
              "content": {
                "description": "The document itself, as the producer wrote it, such as Syft's JSON without its file lists.",
                "type": "object"
              }
            }
          },
          "producer": {
            "description": "What made the inventory, such as Syft at its version.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "type": "ch.bedag.vexplain.scanner.image-contents.v1alpha1",
      "scope": "Hub",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:vexplain:schema:ch.bedag.vexplain.scanner.image-contents.v1alpha1",
        "title": "Image contents",
        "description": "What the scanner found in the filesystem of one platform manifest of an image: how much of each package of the manifest's SBOM is in the filesystem, which ELF files packages own, the shared libraries and what reaches or names them, and whether the image preloads libraries. The SBOM is the manifest's evidence of the type ch.bedag.vexplain.sbom.v1alpha1, which the scan delivers beside this one. The event's coverage is the share of the ELF files that packages own.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "digest",
          "packages",
          "elf",
          "libraries",
          "preload"
        ],
        "properties": {
          "platform": {
            "description": "The platform of the manifest, as os/architecture[/variant].",
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+/[a-z0-9_]+(/[a-z0-9]+)?$"
          },
          "digest": {
            "description": "The digest of the platform manifest.",
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "packages": {
            "description": "The file facts of the packages of the manifest's SBOM, each under its ID there. Null when the SBOM has no package.",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/$defs/packageFacts"
            }
          },
          "elf": {
            "$ref": "#/$defs/elf"
          },
          "libraries": {
            "description": "The shared libraries of the filesystem: the ELF files that have a soname. Null when it has none.",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/$defs/library"
            }
          },
          "preload": {
            "$ref": "#/$defs/preload"
          }
        },
        "$defs": {
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "packageFacts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "filesListed",
              "filesPresent",
              "sharedLibraries",
              "otherElfFiles"
            ],
            "properties": {
              "id": {
                "description": "The package's ID in the manifest's SBOM.",
                "type": "string"
              },
              "filesListed": {
                "description": "The files that the package's database lists.",
                "$ref": "#/$defs/count"
              },
              "filesPresent": {
                "description": "Those of the listed files that are in the final filesystem.",
                "$ref": "#/$defs/count"
              },
              "sharedLibraries": {
                "description": "The ELF files that the package owns and that have a soname.",
                "$ref": "#/$defs/count"
              },
              "otherElfFiles": {
                "description": "The ELF files that the package owns and that have no soname.",
                "$ref": "#/$defs/count"
              }
            }
          },
          "elf": {
            "description": "The ELF files of the filesystem, and those that a package owns.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "total",
              "owned"
            ],
            "properties": {
              "total": {
                "$ref": "#/$defs/count"
              },
              "owned": {
                "$ref": "#/$defs/count"
              },
              "unowned": {
                "description": "The paths of the ELF files that no package owns: the first 100, sorted.",
                "$ref": "#/$defs/paths",
                "minItems": 1,
                "maxItems": 100
              }
            }
          },
          "library": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "soname",
              "reachedCount",
              "nameHitCount"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "soname": {
                "type": "string"
              },
              "packageId": {
                "description": "The ID of the package that owns the library. Absent when none does.",
                "type": "string",
                "minLength": 1
              },
              "reachedBy": {
                "description": "The ELF files, outside the package that owns the library, that reach it through their dependencies: the first 20, sorted.",
                "$ref": "#/$defs/paths",
                "minItems": 1,
                "maxItems": 20
              },
              "reachedCount": {
                "description": "The number of those ELF files.",
                "$ref": "#/$defs/count"
              },
              "nameHits": {
                "description": "The files that name the library: the first 20, sorted.",
                "$ref": "#/$defs/paths",
                "minItems": 1,
                "maxItems": 20
              },
              "nameHitCount": {
                "description": "The number of those files.",
                "$ref": "#/$defs/count"
              }
            }
          },
          "preload": {
            "description": "Whether the image loads libraries that no ELF file asks for. It holds only whether a setting exists, never its value.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ldPreload",
              "ldAudit",
              "etcLdSoPreload"
            ],
            "properties": {
              "ldPreload": {
                "type": "boolean"
              },
              "ldAudit": {
                "type": "boolean"
              },
              "etcLdSoPreload": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  ],
  "watches": false,
  "operations": [
    {
      "name": "scan",
      "description": "Scans an image digest in a Job of its own: what the filesystem of each platform manifest that the pods' nodes run holds, as an SBOM, and the facts of its files and libraries.",
      "role": "Spoke",
      "produces": [
        "ch.bedag.vexplain.sbom.v1alpha1",
        "ch.bedag.vexplain.scanner.image-contents.v1alpha1"
      ],
      "parameterSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "What a scan of an image needs: the repositories that the image was pulled from, and pods that run it.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repositories"
        ],
        "properties": {
          "repositories": {
            "description": "The repositories that the image was pulled from. The scan pulls it from one that a pod pulled it from, or else from the first.",
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          },
          "pods": {
            "description": "Pods that run the image. The scan pulls the image with the credentials of one of them, and scans the platforms of their nodes.",
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "namespace",
                "name"
              ],
              "properties": {
                "namespace": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 63
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253
                }
              }
            }
          }
        }
      }
    }
  ],
  "settingsSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "How the scanner's scan Jobs run. A setting that is left out takes its default.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "maxConcurrentScans": {
        "description": "How many scan Jobs may run at once. 2 by default, and 16 at most: vexplain asks a collector for at most 16 scans at once.",
        "type": "integer",
        "minimum": 1,
        "maximum": 16
      },
      "scanTimeoutSeconds": {
        "description": "How long a scan Job may run before it is stopped. 1800 by default.",
        "type": "integer",
        "minimum": 60,
        "maximum": 21600
      },
      "workspaceMebibytes": {
        "description": "The size of the scratch volume that an image is unpacked into, and so the largest unpacked image that a scan takes. 10240 by default.",
        "type": "integer",
        "minimum": 1024,
        "maximum": 1048576
      },
      "registryMirrors": {
        "description": "Mirrors to pull from in place of registries: a scan pulls an image of the registry host from url, with the same repository path and digest, and never from the registry itself.",
        "type": "array",
        "maxItems": 16,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host",
            "url"
          ],
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      },
      "scanPod": {
        "description": "The pods that the collector creates: pull policy, resources, placement, labels and annotations.",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "imagePullPolicy": {
            "description": "The pull policy of the pods' container. IfNotPresent when it is left out.",
            "enum": [
              "Always",
              "IfNotPresent",
              "Never"
            ]
          },
          "resources": {
            "description": "The resources of the pods' container, as Kubernetes names them.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "limits": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number"
                  ]
                }
              },
              "requests": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number"
                  ]
                }
              },
              "claims": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "request": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "env": {
            "description": "Environment variables of the pods' container, such as a proxy: a value, or a key of a Secret.",
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[-._a-zA-Z][-._a-zA-Z0-9]*$"
                },
                "value": {
                  "type": "string"
                },
                "valueFrom": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "secretKeyRef"
                  ],
                  "properties": {
                    "secretKeyRef": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name",
                        "key"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 253
                        },
                        "key": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 253
                        }
                      }
                    }
                  }
                }
              },
              "oneOf": [
                {
                  "required": [
                    "value"
                  ]
                },
                {
                  "required": [
                    "valueFrom"
                  ]
                }
              ]
            }
          },
          "nodeSelector": {
            "description": "The labels of the nodes that the pods run on.",
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "tolerations": {
            "description": "The taints that the pods tolerate.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string"
                },
                "operator": {
                  "enum": [
                    "Exists",
                    "Equal"
                  ]
                },
                "value": {
                  "type": "string"
                },
                "effect": {
                  "enum": [
                    "NoSchedule",
                    "PreferNoSchedule",
                    "NoExecute"
                  ]
                },
                "tolerationSeconds": {
                  "type": "integer"
                }
              }
            }
          },
          "affinity": {
            "description": "The pods' affinity, as Kubernetes defines it: nodeAffinity, podAffinity and podAntiAffinity.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "nodeAffinity": {
                "type": "object"
              },
              "podAffinity": {
                "type": "object"
              },
              "podAntiAffinity": {
                "type": "object"
              }
            }
          },
          "priorityClassName": {
            "description": "The PriorityClass of the pods.",
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          },
          "runtimeClassName": {
            "description": "The RuntimeClass of the pods, such as one that runs them in a sandbox.",
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          },
          "labels": {
            "description": "Labels to add to the pods'. A label that the collector sets itself stays as it is.",
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "annotations": {
            "description": "Annotations to add to the pods'. An annotation that the collector sets itself stays as it is.",
            "type": "object",
            "propertyNames": {
              "description": "No annotation sets an AppArmor or seccomp profile: the confinement is the collector's.",
              "not": {
                "pattern": "^([^/]*\\.)?(apparmor\\.security\\.beta|seccomp\\.security\\.alpha)\\.kubernetes\\.io/"
              }
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "permissions": [
    {
      "apiGroups": [
        ""
      ],
      "resources": [
        "pods",
        "nodes",
        "secrets",
        "serviceaccounts"
      ],
      "verbs": [
        "get"
      ]
    },
    {
      "apiGroups": [
        "batch"
      ],
      "resources": [
        "jobs"
      ],
      "verbs": [
        "create",
        "get",
        "list",
        "watch",
        "delete"
      ],
      "namespaced": true
    },
    {
      "apiGroups": [
        ""
      ],
      "resources": [
        "secrets"
      ],
      "verbs": [
        "create",
        "get",
        "delete"
      ],
      "namespaced": true
    },
    {
      "apiGroups": [
        ""
      ],
      "resources": [
        "pods"
      ],
      "verbs": [
        "get",
        "list"
      ],
      "namespaced": true
    },
    {
      "apiGroups": [
        ""
      ],
      "resources": [
        "pods/log"
      ],
      "verbs": [
        "get"
      ],
      "namespaced": true
    }
  ]
}
