{
  "roles": [
    "Spoke"
  ],
  "produces": [
    {
      "type": "ch.bedag.vexplain.exposure.v1alpha1",
      "scope": "Spoke",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:vexplain:schema:ch.bedag.vexplain.exposure.v1alpha1",
        "title": "Exposure",
        "description": "How far a workload can be reached.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "external",
          "internalReach",
          "indirect"
        ],
        "properties": {
          "external": {
            "$ref": "#/$defs/external"
          },
          "internalReach": {
            "description": "How far the network policies let the rest of the cluster reach the workload: its own namespace only, specific peers, several namespaces, or the whole cluster.",
            "enum": [
              "Namespace",
              "Peers",
              "Namespaces",
              "Cluster"
            ]
          },
          "indirect": {
            "description": "True when the workload is reachable, one hop away, from a workload that is exposed from outside.",
            "type": "boolean"
          }
        },
        "$defs": {
          "external": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "exposed"
            ],
            "properties": {
              "exposed": {
                "description": "True when something outside the cluster reaches the workload.",
                "type": "boolean"
              },
              "via": {
                "description": "The objects that expose the workload, such as an Ingress or a Service.",
                "type": "array",
                "maxItems": 8,
                "items": {
                  "$ref": "#/$defs/objectRef"
                }
              }
            }
          },
          "objectRef": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "apiGroup",
              "kind",
              "namespace",
              "name"
            ],
            "properties": {
              "apiGroup": {
                "description": "Empty for the core group.",
                "type": "string"
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "namespace": {
                "description": "Empty for an object that has no namespace.",
                "type": "string"
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ],
  "watches": true,
  "settingsSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "What counts as reachable from outside the cluster. A setting that is left out counts everything of its kind as external, which errs towards urgency.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "ingressClasses": {
        "description": "The ingress classes whose Ingresses count as external. Every class counts when the list is left out or empty. An Ingress without a class has the cluster's default class, and counts when no one can tell its class.",
        "type": "array",
        "maxItems": 64,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        }
      },
      "gateways": {
        "description": "The Gateways whose routes count as external, by namespace and name. Every Gateway counts when the list is left out or empty.",
        "type": "array",
        "maxItems": 64,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "namespace",
            "name"
          ],
          "properties": {
            "namespace": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            }
          }
        }
      },
      "internalLoadBalancerAnnotations": {
        "description": "Annotations that make a Service of type LoadBalancer internal: one that has any of them, with its value, isn't external through its load balancer. Its node ports count all the same, unless nodePorts is Internal, and so do its external IPs.",
        "type": "array",
        "maxItems": 32,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "value"
          ],
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 317
            },
            "value": {
              "type": "string",
              "maxLength": 4096
            }
          }
        }
      },
      "nodePorts": {
        "description": "Whether something outside the cluster reaches the nodes' ports, and so the node ports of Services, the host ports of pods, and the pods on their node's network: External, the default, or Internal.",
        "enum": [
          "External",
          "Internal"
        ]
      }
    }
  },
  "permissions": [
    {
      "apiGroups": [
        ""
      ],
      "resources": [
        "pods",
        "namespaces",
        "services"
      ],
      "verbs": [
        "list",
        "watch"
      ]
    },
    {
      "apiGroups": [
        "discovery.k8s.io"
      ],
      "resources": [
        "endpointslices"
      ],
      "verbs": [
        "list",
        "watch"
      ]
    },
    {
      "apiGroups": [
        "networking.k8s.io"
      ],
      "resources": [
        "ingresses",
        "ingressclasses",
        "networkpolicies"
      ],
      "verbs": [
        "list",
        "watch"
      ]
    },
    {
      "apiGroups": [
        "gateway.networking.k8s.io"
      ],
      "resources": [
        "gateways",
        "httproutes",
        "tlsroutes",
        "grpcroutes"
      ],
      "verbs": [
        "list",
        "watch"
      ]
    },
    {
      "apiGroups": [
        "cilium.io"
      ],
      "resources": [
        "ciliumnetworkpolicies",
        "ciliumclusterwidenetworkpolicies"
      ],
      "verbs": [
        "list",
        "watch"
      ]
    },
    {
      "apiGroups": [
        "apps"
      ],
      "resources": [
        "replicasets"
      ],
      "verbs": [
        "list",
        "watch"
      ]
    },
    {
      "apiGroups": [
        "batch"
      ],
      "resources": [
        "jobs"
      ],
      "verbs": [
        "list",
        "watch"
      ]
    }
  ]
}
